# Go API
PORT=8080
CORS_ORIGINS=http://localhost:5173
EVALUATION_PATH=../ml/artifacts/evaluation.json

# Frontend; empty uses Vite proxy in development
VITE_API_BASE_URL=

# Optional Python model service; not required in demo mode
INFERENCE_URL=http://localhost:8001
MODEL_ARTIFACT=ml/artifacts/verityflow-model.joblib
GEMINI_MODEL=gemini-2.5-flash
# Configure GOOGLE_API_KEY (Gemini API key) OR use Vertex AI ADC with
# GOOGLE_GENAI_USE_VERTEXAI=true, GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
