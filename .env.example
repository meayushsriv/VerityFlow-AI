# Go API
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Frontend; empty uses Vite proxy in development
VITE_API_BASE_URL=

# Optional Gemini investigations; not required in demo mode
GEMINI_MODEL=gemini-2.5-flash
# Configure GOOGLE_API_KEY (Gemini API key) OR use Vertex AI ADC with
# GOOGLE_GENAI_USE_VERTEXAI=true, GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
